# jinro-community 환경변수. 실제 값은 .env.local 에 넣으세요 (git 무시됨).
# 이 프로젝트는 자체 Firebase 프로젝트를 씁니다 (moon2 컨벤션: 앱마다 독립 DB).

# --- Firebase 클라이언트 (브라우저 노출 가능, Phase 2 Auth용) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (서버 전용 — 절대 클라이언트 노출 금지) ---
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > "새 비공개 키 생성"의 JSON에서 옮겨오세요.
# PRIVATE_KEY 는 따옴표로 감싸고 줄바꿈을 \n 으로 둡니다.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Claude API (서버 전용 — 수업앱 빌더의 AI 블록용) ---
# 없으면 AI 기능만 비활성(제출은 정상 저장). platform.claude.com 에서 발급.
ANTHROPIC_API_KEY=

# --- 유튜브 자막 폴백 (서버 전용, 선택) ---
# 유튜브는 데이터센터 IP에서 오는 자막 요청을 차단한다. 그래서 같은 영상이
# 로컬에서는 자막이 읽히는데 Vercel 배포본에서는 "자막 없는 영상"처럼 응답해
# 문항이 0개 생성됐다(2026-07-27 실측). 이 키가 있으면 무료 경로가 실패했을 때
# supadata.ai로 대본을 받아온다. 없으면 교사에게 "대본을 가져오지 못했다"고
# 정직하게 안내하고 붙여넣기를 유도한다(문항을 지어내지 않음).
# supadata.ai 가입 후 발급. 요청 1건 = 1 크레딧 (무료 100건/월).
SUPADATA_API_KEY=

# --- AI 받아쓰기 무료 할당량 (교사 1인 기준, 선택) ---
# 자막이 아예 없는 영상은 AI가 음성을 받아쓸 수 있는데, 요금이
# **영상 1분당 2 크레딧**이다. 즉 비용이 요청 수가 아니라 길이에 비례한다
# (30분 영상 1개 = 10분 영상 3개). 그래서 두 겹으로 막는다:
#   USES  = 교사에게 보여줄 횟수 ("무료 3회 중 2회 남음")
#   CAP   = 보이지 않는 크레딧 상한. 긴 영상 하나가 할당량을 통째로
#           먹는 경우를 막는다. 기본 80 ≈ 10분 영상 4편.
#   MAX_MINUTES = 이보다 긴 영상은 시도조차 하지 않는다.
# 셋 다 비워두면 3회 / 80크레딧 / 20분이 적용된다.
AI_TRANSCRIPT_FREE_USES=
AI_TRANSCRIPT_CREDIT_CAP=
AI_TRANSCRIPT_MAX_MINUTES=

# --- Firebase Storage 버킷 (원본 PDF 저장) ---
# 콘솔 > Storage 활성화 후 버킷명. 보통 NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET 과 동일.
# 안 넣으면 NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET 을 사용.
FIREBASE_STORAGE_BUCKET=

# --- 정보 수신 시크릿 (서버 전용) ---
# kakao-daily가 생성 정보를 POST /api/info 로 밀어넣을 때 쓰는 공유 시크릿.
# kakao-daily 쪽에도 같은 값을 넣고, 요청 헤더 x-ingest-secret 로 보냅니다.
INFO_INGEST_SECRET=
